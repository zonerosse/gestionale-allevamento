/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

# l'app sul telefono deve sempre chiedere se c'è una versione nuova (ottobre 2026)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/proprietario.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# riconoscitore dei visi (12/10/2026): file che non cambiano, il browser li tiene
/vendor/visi/*
  Cache-Control: public, max-age=31536000, immutable
